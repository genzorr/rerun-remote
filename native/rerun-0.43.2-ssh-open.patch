+fn is_remote_recording(value: &str) -> bool {
+    let Some((alias, path)) = value.split_once(':') else { return false; };
+    alias.as_bytes().first().is_some_and(u8::is_ascii_alphanumeric)
+        && alias.bytes().all(|byte| byte.is_ascii_alphanumeric() || b"_.-".contains(&byte))
+        && path.starts_with('/')
+        && !path.starts_with("//")
+        && !path.contains(['\n', '\r', '\0'])
+        && path.rsplit_once('.').is_some_and(|(_, extension)| extension.eq_ignore_ascii_case("rrd"))
+}
+
+#[cfg(unix)]
+#[derive(Default)]
+struct RemoteOpen {
+    pending: Option<std::sync::mpsc::Receiver<Result<(), String>>>,
+    error: Option<String>,
+}
+
+#[cfg(unix)]
+impl RemoteOpen {
+    fn poll(&mut self) -> bool {
+        let Some(pending) = &self.pending else { return false; };
+        let result = match pending.try_recv() {
+            Ok(result) => result,
+            Err(std::sync::mpsc::TryRecvError::Empty) => return false,
+            Err(std::sync::mpsc::TryRecvError::Disconnected) => {
+                Err("The remote recording request ended unexpectedly.".to_owned())
+            }
+        };
+        self.pending = None;
+        self.error = result.err();
+        self.error.is_none()
+    }
+
+    fn send(&mut self, endpoint: std::ffi::OsString, target: String, ctx: egui::Context) {
+        let (sender, receiver) = std::sync::mpsc::channel();
+        self.error = None;
+        self.pending = Some(receiver);
+        std::thread::spawn(move || {
+            let result = open_remote(&endpoint, &target);
+            let _ = sender.send(result);
+            ctx.request_repaint();
+        });
+    }
+}
+
+#[cfg(unix)]
+fn open_remote(endpoint: &std::ffi::OsStr, target: &str) -> Result<(), String> {
+    use std::io::{BufRead as _, BufReader, Read as _, Write as _};
+    use std::os::unix::net::UnixStream;
+    use std::time::Duration;
+
+    let exchange = || -> std::io::Result<String> {
+        let mut stream = UnixStream::connect(endpoint)?;
+        stream.set_read_timeout(Some(Duration::from_secs(1320)))?;
+        stream.set_write_timeout(Some(Duration::from_secs(5)))?;
+        writeln!(stream, "{target}")?;
+        let mut result = String::new();
+        BufReader::new(stream).take(4096).read_line(&mut result)?;
+        Ok(result)
+    };
+    let result = exchange().map_err(|error| format!("Cannot reach rerun-remote: {error}"))?;
+    if result == "OK\n" {
+        Ok(())
+    } else if let Some(error) = result.strip_prefix("ERROR ") {
+        Err(error.trim_end().to_owned())
+    } else {
+        Err("rerun-remote did not complete the recording request.".to_owned())
+    }
+}
